#!/bin/bash
# Mock rpm — records invocation into $MOCK_LOG.
#
# Test-time controls (env vars):
#   MOCK_LOG              Path to append the invocation log
#   MOCK_RPM_INSTALLED    Space-separated list of "installed" package names
#                         (used by `rpm -q <name>` checks; "*" matches all)
#   MOCK_RPM_NEEDS        Space-separated "target|capability|requirer" triples:
#                         installed `requirer` needs `capability`, which the
#                         installed `target` provides. Drives `rpm -e --test`
#                         and the provides query pkg.py's drop makes.
printf 'rpm %s\n' "$*" >>"${MOCK_LOG:-/tmp/mock.log}"

# Split without globbing, so "*" stays a word.
read -r -a mock_installed <<<"${MOCK_RPM_INSTALLED:-}"
read -r -a mock_needs <<<"${MOCK_RPM_NEEDS:-}"

mock_is_installed() {
  local pkg
  for pkg in "${mock_installed[@]}"; do
    [[ $pkg == "*" || $pkg == "$1" ]] && return 0
  done
  return 1
}

# `rpm -e --test [--allmatches] -- <name>...`: report each dependency the
# removal would break the way rpm does (a header, then one tab-indented line
# per unmet dependency, exit status = their count), counting only requirers
# outside the removal set.
if [[ ${1:-} == "-e" ]]; then
  shift
  while [[ ${1:-} == --* ]]; do
    [[ $1 == "--" ]] && { shift; break; }
    shift
  done
  declare -A erasing=()
  for name in "$@"; do erasing[$name]=1; done
  lines=()
  for name in "$@"; do
    if ! mock_is_installed "$name"; then
      printf 'error: package %s is not installed\n' "$name" >&2
      exit 1
    fi
  done
  for triple in "${mock_needs[@]}"; do
    IFS='|' read -r target cap requirer <<<"$triple"
    [[ -n ${erasing[$target]:-} && -z ${erasing[$requirer]:-} ]] || continue
    lines+=("$(printf '\t%s is needed by (installed) %s-1.0-1.fc44.x86_64' "$cap" "$requirer")")
  done
  if (( ${#lines[@]} )); then
    printf 'error: Failed dependencies:\n' >&2
    printf '%s\n' "${lines[@]}" >&2
  fi
  exit "${#lines[@]}"
fi

# The provides query pkg.py's drop makes: "name<TAB>arch<TAB>capability" rows,
# the package's own name plus every capability MOCK_RPM_NEEDS gives it.
if [[ ${1:-} == "-q" && ${2:-} == "--qf" && ${3:-} == *PROVIDENAME* ]]; then
  shift 3
  [[ ${1:-} == "--" ]] && shift
  for name in "$@"; do
    mock_is_installed "$name" || { printf 'package %s is not installed\n' "$name"; continue; }
    printf '%s\tx86_64\t%s\n' "$name" "$name"
    for triple in "${mock_needs[@]}"; do
      IFS='|' read -r target cap _ <<<"$triple"
      [[ $target == "$name" ]] && printf '%s\tx86_64\t%s\n' "$name" "$cap"
    done
  done
  exit 0
fi

# `rpm -q --qf <format> [--] <name>...`, the batched form pkg.py's `installed`
# uses: render the format for each installed name (NAME and ARCH only), and
# report the rest on stdout the way rpm does. MOCK_RPM_INSTALLED="*" reports
# every name installed.
if [[ ${1:-} == "-q" && ${2:-} == "--qf" ]]; then
  format=$3
  shift 3
  [[ ${1:-} == "--" ]] && shift
  missing=0
  for name in "$@"; do
    found=0
    for pkg in "${mock_installed[@]}"; do
      [[ $pkg == "*" || $pkg == "$name" ]] && found=1
    done
    if ((found)); then
      rendered=${format//%\{NAME\}/$name}
      rendered=${rendered//%\{ARCH\}/x86_64}
      printf '%b' "$rendered"
    else
      printf 'package %s is not installed\n' "$name"
      missing=$((missing + 1))
    fi
  done
  exit "$missing"
fi

# Implement enough of `rpm -q <name>` semantics for tests to work.
if [[ ${1:-} == "-q" && -n ${2:-} ]]; then
  for pkg in "${mock_installed[@]}"; do
    if [[ $pkg == "*" || $pkg == "$2" ]]; then
      printf '%s-1.0-1.fc44.x86_64\n' "$2"
      exit 0
    fi
  done
  printf 'package %s is not installed\n' "$2" >&2
  exit 1
fi

# Implement `rpm -qf <path>` for kernel-update detection tests.
if [[ ${1:-} == "-qf" && -n ${2:-} ]]; then
  if [[ -n ${MOCK_RPM_KERNEL_OWNER:-} ]]; then
    printf '%s\n' "$MOCK_RPM_KERNEL_OWNER"
    exit 0
  fi
  printf 'file %s is not owned by any package\n' "$2" >&2
  exit 1
fi

exit "${MOCK_RPM_EXIT:-0}"
