#!/bin/bash

# omarchy:summary=Returns true if the AUR is up and available.

# Fedora dispatch — there is no AUR on Fedora; report it unreachable so every
# AUR-conditional flow (update, install TUI) no-ops. See omedora/architecture.md §3.
case "${OMARCHY_DISTRO:-$(omarchy-distro 2>/dev/null || echo arch)}" in
  fedora) exit 1 ;;
esac

curl -sf --connect-timeout 30 --retry 3 --retry-delay 3 -A "omarchy-update" \
  "https://aur.archlinux.org/rpc/?v=5&type=info&arg=base" >/dev/null
