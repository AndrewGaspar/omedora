#!/bin/bash

# omarchy:summary=Update Omarchy and system packages
# omarchy:args=[-y]
# omarchy:examples=omarchy update | omarchy update -y
# omarchy:requires-sudo=true

set -e

# Run the update inside a PTY so pacman/yay keep showing download progress
# while still logging the full session for later analysis.
#
# `script` (the PTY logger) lives in util-linux on Arch but is split into the
# util-linux-script package on Fedora 44, which a minimal base may not have. If
# it's missing, fall through and run the update UNLOGGED rather than aborting
# the whole update with `env: 'script': No such file or directory`. omedora
# installs util-linux-script (see install/packaging/fedora-baseline.sh) so fresh
# Fedora installs still get the logged path; Arch always has `script`, so its behavior
# is unchanged.
if [[ -z $OMARCHY_UPDATE_LOGGED ]] && command -v script &>/dev/null; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env OMARCHY_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/omarchy-update.log"
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, get help from the community at https://omarchy.org/discord\033[0m"' ERR

# Omedora has no community channel yet, so drop the upstream Omarchy community
# line on Fedora (Arch trap above stays byte-identical to upstream).
# TODO(omedora): point this at an Omedora community/support channel once one exists.
if [[ "$(omarchy-distro 2>/dev/null || echo arch)" == "fedora" ]]; then
  trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\033[0m"' ERR
fi

if [[ $1 == "-y" ]] || omarchy-update-confirm; then
  # omarchy-snapshot is Arch/btrfs+snapper — omedora doesn't own the Fedora boot
  # stack, so skip it there. omarchy-update-perform itself dispatches to the
  # Fedora pipeline (dnf instead of pacman/AUR).
  if [[ "$(omarchy-distro 2>/dev/null || echo arch)" != "fedora" ]]; then
    omarchy-snapshot create || (($? == 127))
  fi
  omarchy-update-git
  omarchy-update-perform
fi
