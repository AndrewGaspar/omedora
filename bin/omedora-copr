#!/bin/bash

# omarchy:summary=Print the omedora COPR project (owner/project) or its dnf repo id.
# omarchy:args=[--repo-id]
# omarchy:examples=omedora copr | omedora copr --repo-id

# Single source of truth for the omedora COPR name.
#
# The COPR is SCOPED PER OMARCHY MAJOR LINE: its project name is derived from the
# MAJOR component of the Omarchy base version this omedora is rebased on (the
# `version` file). So the whole Omarchy 3.x line shares one COPR (omedora-3), and
# a rebase onto Omarchy 4.x selects a new, isolated COPR (omedora-4) — existing
# installs never get cross-contaminated by an ABI-incompatible rebuild, but a
# routine patch bump (3.8.2 -> 3.8.3) does NOT spin up a new COPR.
#
#   owner   : $OMEDORA_COPR_OWNER (default: agaspar)
#   project : omedora-<major>     (major of the `version` file, e.g. 3.8.2 -> 3)
#
# Modes:
#   (default)   print "owner/project"                     e.g. agaspar/omedora-3
#   --repo-id   print the dnf repo id dnf records as       e.g.
#               copr:copr.fedorainfracloud.org:agaspar:omedora-3
#
# Everything that needs the COPR name (install/preflight/fedora-repos.sh, the
# COPR submit script, the L3/L4 tests) MUST go through this — never hard-code it.

set -euo pipefail

owner="${OMEDORA_COPR_OWNER:-agaspar}"

# Resolve the Omarchy base version file: prefer the installed payload, then the
# repo this script lives in, then the packaged payload location (installed
# /usr/bin copies resolve beside /usr, where no version file lives, and
# OMARCHY_PATH is unset outside a session).
if [[ -n ${OMARCHY_PATH:-} && -f "$OMARCHY_PATH/version" ]]; then
  base_file="$OMARCHY_PATH/version"
else
  base_file="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)/version"
  [[ -f $base_file ]] || base_file="/usr/share/omarchy/version"
fi
base="$(cat "$base_file" 2>/dev/null || echo unknown)"
major="${base%%.*}"   # 3.8.2 -> 3 ; one COPR per Omarchy major line

project="omedora-${major}"

case "${1:-}" in
  --repo-id) printf 'copr:copr.fedorainfracloud.org:%s:%s\n' "$owner" "$project" ;;
  "")        printf '%s/%s\n' "$owner" "$project" ;;
  *) echo "omedora-copr: unknown arg: $1" >&2; exit 2 ;;
esac
