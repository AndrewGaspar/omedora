#!/bin/bash

# omarchy:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the Omarchy default and rebuild it.
# omarchy:requires-sudo=true

# Fedora dispatch — Omedora does not own the boot Plymouth theme on Fedora
# (plymouth is skip-mapped in install/packages/fedora.toml; no omedora theme is
# installed to /usr/share/plymouth/themes/omarchy). The Arch path below would
# write into a non-existent theme dir and then fall back to `mkinitcpio -P`
# (Arch initramfs; Fedora uses dracut) — a hard error. No-op with a note and
# exit 0. Arch path below is unchanged.
case "${OMARCHY_DISTRO:-$(omarchy-distro 2>/dev/null || echo arch)}" in
  fedora)
    echo "Omedora keeps Fedora's stock boot splash; there's no Omarchy Plymouth theme to refresh."
    exit 0
    ;;
esac

sudo cp -r "$OMARCHY_PATH/default/plymouth/." /usr/share/plymouth/themes/omarchy/
sudo plymouth-set-default-theme omarchy

if omarchy-cmd-present limine-mkinitcpio; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi
