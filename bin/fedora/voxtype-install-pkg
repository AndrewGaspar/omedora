#!/bin/bash
#
# Fedora-only voxtype installer — the omedora-owned sibling exec'd by
# bin/omarchy-voxtype-install's Fedora arm (zero upstream rebase surface).
#
# voxtype is hosted in the omedora COPR (omedora/packaging/copr/voxtype.spec) as
# a single from-source RPM built from the AndrewGaspar/voxtype fork
# (feat/muse-stack-v1.0.1, CPU-only: tiered whisper avx2/avx512/vulkan binaries
# + OSD helpers). There are no GPU add-on subpackages — the old voxtype-cuda /
# voxtype-migraphx split died with the 0.7.5 binary-repackage; GPU users get
# acceleration from the Vulkan tier instead (the RPM's %post symlinks the best
# tier, and `voxtype setup gpu --enable` still switches to it at setup time).
#
# This installs the base (wtype, the wlroots typing backend native in Fedora
# repos, plus voxtype-bin -> voxtype via the package map) and nothing else.
#
# Everything goes through omarchy-pkg-add, which maps the names via
# install/packages/fedora.toml and honors $OMARCHY_PKG_DRY_RUN downstream
# (bin/fedora/pkg.py), so a dry-run logs the dnf calls instead of running them.
#
# Updates ride dnf: a `Version:` / fork-commit (+ .sources sha) bump in the spec
# rebuilds the COPR and `omarchy update` / `dnf update` delivers the fix. No
# download/sha pin here — the COPR's SRPM step fetches + sha-verifies upstream.

set -euo pipefail

# Base: wtype (the wlroots typing backend, native in Fedora repos) + the
# from-source voxtype RPM (voxtype-bin -> voxtype via the package map).
omarchy-pkg-add wtype voxtype-bin

echo "Installed voxtype (CPU + Vulkan tiers; the Vulkan tier accelerates inference on any GPU vendor)."
