#!/bin/bash
#
# Fedora sibling of bin/omarchy-pkg-install (exec'd by its distro dispatch):
# the same fzf picker UX over dnf's available-package list instead of pacman's.
# Mirrors the upstream flow — multi-select, info preview, install, done toast.

set -euo pipefail

fzf_args=(
  --multi
  --preview 'dnf -q info {1} 2>/dev/null || echo "(no info)"'
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:green,marker:green'
)

# Available package names from all enabled repos (cached metadata; fast after
# the first run). --available keeps installed-only packages out of the list.
pkg_names=$(dnf -q repoquery --available --qf '%{name}\n' 2>/dev/null | sort -u | fzf "${fzf_args[@]}")

if [[ -n $pkg_names ]]; then
  source omarchy-sudo-keepalive

  # Convert newline-separated selections to space-separated for dnf
  echo "$pkg_names" | tr '\n' ' ' | xargs sudo dnf install -y
  omarchy-show-done
fi
