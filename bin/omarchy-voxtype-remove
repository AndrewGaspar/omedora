#!/bin/bash

# omarchy:summary=Remove Voxtype dictation and its configuration
# omarchy:requires-sudo=true

set -e

# Remove voxtype and its configurations.

if omarchy-cmd-present voxtype; then
  echo "Uninstall Voxtype to remove dictation."

  # Remove services
  systemctl --user disable --now voxtype.service 2>/dev/null || true
  systemctl --user daemon-reload

  # Remove packages and configs
  # Fedora installs the upstream RPM (Name: voxtype) via
  # bin/fedora/voxtype-install-pkg, not the Arch voxtype-bin package; remove the
  # right one per distro. The Arch arm reproduces the upstream line verbatim.
  case "${OMARCHY_DISTRO:-$(omarchy-distro 2>/dev/null || echo arch)}" in
    fedora) sudo "${OMEDORA_DNF_CMD:-dnf}" remove -y voxtype ;;
    *) omarchy-pkg-drop voxtype-bin ;;
  esac
  rm -rf ~/.config/voxtype
  rm -rf ~/.local/share/voxtype
  hyprctl reload >/dev/null
else
  echo "Voxtype was not installed."
fi
