declare -A known_config_default_hashes_by_key=()
while IFS=$'\t' read -r action rel hash; do
  [[ -n ${action:-} && $action != \#* ]] || continue
  known_config_default_hashes_by_key["$action:$rel:$hash"]=1
done < <(known_config_default_hashes)

default_hash_paths() {
  local action_filter="$1" action rel hash
  known_config_default_hashes | while IFS=$'\t' read -r action rel hash; do
    [[ -n ${action:-} && $action != \#* ]] || continue
    [[ $action == "$action_filter" ]] || continue
    printf '%s\n' "$rel"
  done | sort -u
}

is_known_default_hash() {
  local action="$1" rel="$2" file="$3" hash
  [[ -f $file ]] || return 1
  hash=$(file_sha256 "$file")
  [[ -n ${known_config_default_hashes_by_key["$action:$rel:$hash"]+set} ]]
}

# v4-only config entry points: a 3.8.2 install cannot have an omedora-shipped
# copy of these, so the v4 default is always installed (backup-then-write if
# something user-made already sits at the path).
always_copy_config_files=(
  hypr/.luarc.json
  hypr/autostart.lua
  hypr/bindings.lua
  hypr/hyprland.lua
  hypr/input.lua
  hypr/looknfeel.lua
  hypr/monitors.lua
  omarchy/bar.json
  omarchy/extensions/omarchy-menu.jsonc
  omarchy/hooks/pre-refresh-pacman.d/add-custom-repo.sample
  omarchy/shell.json
)

# Legacy UI config dirs replaced wholesale by the Quickshell shell. Moved to
# .bak (never rm'd — coexistence rule; upstream rm -rf's elephant/wiremix).
retired_config_dirs=(waybar swayosd mako walker elephant wiremix)

plan_refresh=()   # hash-matched shipped defaults -> replaced with v4 defaults
plan_keep=()      # customized (hash mismatch)    -> kept active, never touched
plan_retire=()    # package now owns the file     -> backed up, then removed
plan_override=()  # customized retired file       -> backed up, copy stays active
plan_always=()    # v4 entry points colliding with an existing file -> backup+write
classify_user_configs() {
  local rel file
  while IFS= read -r rel; do
    file="$HOME/.config/$rel"
    [[ -f $file ]] || continue
    if is_known_default_hash refresh "$rel" "$file"; then
      plan_refresh+=("$rel")
    else
      plan_keep+=("$rel")
    fi
  done < <(default_hash_paths refresh)

  while IFS= read -r rel; do
    file="$HOME/.config/$rel"
    [[ -f $file ]] || continue
    if is_known_default_hash retire "$rel" "$file"; then
      plan_retire+=("$rel")
    else
      plan_override+=("$rel")
    fi
  done < <(default_hash_paths retire)

  for rel in "${always_copy_config_files[@]}"; do
    [[ -e $HOME/.config/$rel ]] && plan_always+=("$rel")
  done
  return 0   # the last [[ -e ]] above may be false; don't trip set -e
}
classify_user_configs

# --- the plan gate (BEFORE any change; omedora/install/plan.sh idiom) ----------

omedora_upgrade_plan_summary() {
  echo
  echo -e "\033[1mOmedora 4 upgrade plan\033[0m  (nothing has been changed yet)"
  echo
  echo -e "\033[1m  Repos (COPR swap):\033[0m"
  echo "      • enable the omedora 4 COPR: $new_copr"
  echo "      • disable the 3.8.2-line COPR after success: $old_copr"
  echo
  echo -e "\033[1m  Packages:\033[0m"
  echo "      • dnf install omedora + omedora-settings (one transaction: the"
  echo "        omarchy-* commands, /usr/share/omarchy payload, the 'Omedora' GDM"
  echo "        session entry — which Obsoletes/replaces hyprland-omedora atomically,"
  echo "        so the session entry is never absent)"
  echo "      • install any NEW v4 base packages not yet present (quickshell, foot,"
  echo "        ...) resolved through the v4 package map"
  if ((${#retired_packages[@]})); then
    echo -e "\033[33m      • remove ${#retired_packages[@]} retired package(s) (replaced by the Quickshell shell"
    echo -e "        or by NetworkManager/bluez; removal failures are tolerated):\033[0m"
    printf '%s\n' "${retired_packages[@]}" | tr '\n' ' ' | fold -s -w 68 | sed 's/^/          /'
    echo
  else
    echo "      • no retired packages to remove"
  fi
  if ((${#retired_kept_for_dependents[@]})); then
    echo "      • kept although retired — other installed software still requires them"
    echo "        (dnf would remove the dependents too; remove manually if unwanted):"
    printf '          %s\n' "${retired_kept_for_dependents[@]}"
  fi
  echo
  echo -e "\033[1m  Your configs (hash-match engine, backup-then-write):\033[0m"
  echo "      A file matching a KNOWN omedora/omarchy-shipped default is refreshed;"
  echo "      anything else is yours and stays active. Every replaced/retired file"
  echo "      is first backed up to <file>.$backup_tag(.bak)."
  ((${#plan_refresh[@]})) &&
    { echo "      ${#plan_refresh[@]} unmodified shipped default(s) refreshed to the v4 version:"
      printf '          ~/.config/%s\n' "${plan_refresh[@]}"; }
  ((${#plan_keep[@]})) &&
    { echo "      ${#plan_keep[@]} customized file(s) kept active, never touched:"
      printf '          ~/.config/%s\n' "${plan_keep[@]}"; }
  ((${#plan_retire[@]})) &&
    { echo "      ${#plan_retire[@]} unmodified file(s) retired (the package now ships them under /usr; backed up first):"
      printf '          ~/.config/%s\n' "${plan_retire[@]}"; }
  ((${#plan_override[@]})) &&
    { echo "      ${#plan_override[@]} customized retired file(s) backed up; your copy STAYS active as an override:"
      printf '          ~/.config/%s\n' "${plan_override[@]}"; }
  echo "      v4 config entry points written (hypr/*.lua, omarchy/bar.json, omarchy/shell.json):"
  if ((${#plan_always[@]})); then
    echo "        these existing files at those paths will be backed up first:"
    printf '          ~/.config/%s\n' "${plan_always[@]}"
  else
    echo "        (no collisions: nothing exists at those paths yet)"
  fi
  echo "      legacy UI config dirs moved to .$backup_tag.bak: ${retired_config_dirs[*]}"
  echo "      ~/.config/hypr/*.conf: left in place for reference (inert under v4's Lua config)"
  echo "      ~/.config/uwsm/env: backed up; your custom lines move to uwsm/env.d/99-omarchy-upgrade-env"
  echo "      ~/.bashrc: never touched (the 3.8.2 sourcing block keeps working via the compat symlink)"
  echo "      ~/.config/git/config: never touched (your git identity is protected)"
  echo "      default browser / mailto handlers: untouched (your 3.8.2-era choices stand)"
  echo
  echo -e "\033[1m  Legacy checkout retirement:\033[0m"
  echo "      • your git checkout moves to: $legacy_backup"
  echo "      • ~/.local/share/omarchy becomes a symlink to /usr/share/omarchy"
  echo "        (with a temporary Hyprland-conf overlay if your CURRENT session still"
  echo "        runs the legacy .conf config, so it survives until you log out)"
  echo "      • retired user services disabled (swayosd/elephant/walker/battery-monitor);"
  echo "        live waybar/walker/mako processes are only stopped AFTER the new"
  echo "        Quickshell shell responds in your session (or at reboot)"
  echo
  echo -e "\033[1m  System (root):\033[0m"
  echo "      • omarchy-setup-system --upgrade from the installed payload: Fedora-gated"
  echo "        (lock-screen PAM service /etc/pam.d/omarchy-lock-*, docker group +"
  echo "        daemon.json only-if-absent, firewalld LocalSend/docker-DNS rules,"
  echo "        service enables for installed components)"
  echo "      • NEVER touched: /etc/os-release, nsswitch.conf, faillock, existing"
  echo "        pam.d files, GDM config, bootloader, initramfs"
  echo
}

# Prompt from the CONTROLLING TERMINAL (/dev/tty) when there is one; otherwise
# leave stdin alone (NEVER redirect from /dev/stdin — a consumed/closed pipe
# makes that abort; see omedora/install/plan.sh for the full story).
PROMPT_TTY=""
if { true >/dev/tty; } 2>/dev/null; then PROMPT_TTY=/dev/tty; fi
# When a test forces the interactivity branch, prompts must come from the
# harness-provided stdin, never the developer's real terminal.
if [[ -n ${OMEDORA_PLAN_FORCE_INTERACTIVE:-} || -n ${OMEDORA_PLAN_FORCE_NONINTERACTIVE:-} ]]; then
  PROMPT_TTY=""
fi

prompt_stdin() {
  if [[ -n $PROMPT_TTY ]]; then "$@" <"$PROMPT_TTY"; else "$@"; fi
}

interactive=1
if (( yes )) || [[ -n ${OMEDORA_PLAN_AUTOCONFIRM:-} ]] || [[ -z $PROMPT_TTY ]]; then
  interactive=0
fi
# Test seams (same names as omedora/install/plan.sh).
[[ -n ${OMEDORA_PLAN_FORCE_INTERACTIVE:-} ]] && interactive=1
[[ -n ${OMEDORA_PLAN_FORCE_NONINTERACTIVE:-} ]] && interactive=0

# Snapshot offer (opt-in, interactive only, btrfs only; exit-127-tolerant).
if [[ $interactive -eq 1 && -z ${OMEDORA_SNAPSHOT:-} ]] \
   && [[ "$(findmnt -no FSTYPE / 2>/dev/null || true)" == "btrfs" ]]; then
  echo
  echo -e "\033[1mPre-upgrade snapshot\033[0m  (your root is btrfs)"
  echo "  Omedora can snapshot / now so the whole upgrade is reversible later with"
  echo "  'omedora snapshot rollback pre-omedora-4' (/home is a separate subvolume"
  echo "  and is never touched)."
  if command -v gum >/dev/null 2>&1; then
    prompt_stdin gum confirm "Take a pre-upgrade snapshot first?" && export OMEDORA_SNAPSHOT=1
  else
    prompt_stdin read -r -p "  Take a pre-upgrade snapshot first? [Y/n] " reply
    [[ $reply =~ ^[Nn] ]] || export OMEDORA_SNAPSHOT=1
  fi
fi

if [[ $interactive -eq 0 ]]; then
  omedora_upgrade_plan_summary >&2
  if (( yes )) || [[ -n ${OMEDORA_PLAN_AUTOCONFIRM:-} ]]; then
    echo -e "\033[32mOmedora: proceeding with the upgrade plan above (--yes/autoconfirm).\033[0m" >&2
  else
    # An upgrade is more invasive than an install; without a terminal we will
    # not guess. Mirrors upstream's no-TTY refusal.
    fail "No terminal available to confirm the upgrade. Re-run with --yes (or OMEDORA_PLAN_AUTOCONFIRM=1) to proceed non-interactively. Nothing was changed."
  fi
else
  omedora_upgrade_plan_summary
  proceed=0
  if command -v gum >/dev/null 2>&1; then
    prompt_stdin gum confirm "Proceed with the omedora 4 upgrade (apply everything listed above)?" && proceed=1
  else
    prompt_stdin read -r -p "Proceed with the omedora 4 upgrade (apply everything listed above)? [y/N] " reply
    case "$reply" in [yY] | [yY][eE][sS]) proceed=1 ;; esac
  fi
  if (( proceed != 1 )); then
    echo -e "\033[31mOmedora: upgrade aborted at your request. Nothing was changed.\033[0m" >&2
    exit 1
  fi
  echo -e "\033[32mOmedora: proceeding. Existing files will be backed up before they are replaced.\033[0m"
fi

# ===============================================================================
# From here on, changes are made.
# ===============================================================================

sudo_keepalive_pid=""
cleanup_on_exit() {
  local exit_status=$?
  if [[ -n ${sudo_keepalive_pid:-} ]]; then
    kill "$sudo_keepalive_pid" 2>/dev/null || true
  fi
  if [[ -n ${OMEDORA_UPGRADE_REEXEC:-} && -f ${OMEDORA_UPGRADE_REEXEC:-} ]]; then
    rm -f "$OMEDORA_UPGRADE_REEXEC" 2>/dev/null || true
  fi
  exit "$exit_status"
}
trap cleanup_on_exit EXIT

if [[ -t 0 ]]; then
  while true; do sudo -n true; sleep 60; done 2>/dev/null &
  sudo_keepalive_pid=$!
fi

# --- 1. snapshot (if accepted) --------------------------------------------------

take_snapshot() {
  [[ -n ${OMEDORA_SNAPSHOT:-} ]] || return 0
  local snap_bin="$legacy_root/bin/omedora-snapshot"
  [[ -x $snap_bin ]] || snap_bin=$(command -v omedora-snapshot 2>/dev/null || true)
  if [[ -z $snap_bin ]]; then
    warn "omedora-snapshot not found; continuing without a snapshot."
    return 0
  fi
  log "Taking pre-upgrade btrfs snapshot (pre-omedora-4)"
  "$snap_bin" create pre-omedora-4 ||
    warn "Pre-upgrade snapshot failed (rc=$?); continuing without it."
}
take_snapshot

# --- 2. repos + packages --------------------------------------------------------

enable_omedora_4_copr() {
  log "Enabling the omedora 4 COPR ($new_copr)"
  sudo dnf install -y dnf-plugins-core >/dev/null 2>&1 || true
  sudo dnf -y copr enable "$new_copr"
}

install_omedora_4_packages() {
  log "Installing omedora 4 packages (omedora + omedora-settings, one transaction)"
  # omedora-settings Provides/Obsoletes hyprland-omedora, so dnf swaps the old
  # session-entry package atomically inside this transaction — the Omedora GDM
  # session entry is never absent.
  sudo dnf install -y omedora omedora-settings
  sudo dnf mark user omedora omedora-settings >/dev/null 2>&1 ||
    warn "Could not mark omedora/omedora-settings as user-installed."

  [[ -d $payload ]] || fail "$payload was not installed (the omedora package payload is missing)."
  [[ -f /usr/share/wayland-sessions/omedora.desktop ]] ||
    warn "/usr/share/wayland-sessions/omedora.desktop is missing — the GDM session entry did not land; check the dnf output above."
}

# Fedora desktop baseline the 4.x installer adds (omedora/install/
# fedora-baseline.packages); a 3.8.2 install already has all but xdg-user-dirs,
# and the resolver below only installs what's missing anyway.
fedora_baseline_packages=(
  xdg-utils xdg-user-dirs pipewire pipewire-pulseaudio pipewire-alsa util-linux-script
)

install_new_base_packages() {
  local pkg_py="$payload/bin/fedora/pkg.py"
  [[ -f $pkg_py ]] || pkg_py=/usr/bin/fedora/pkg.py
  if [[ ! -f $pkg_py || ! -f $payload/install/omarchy-base.packages ]]; then
    warn "Installed payload lacks the package resolver; skipping the v4 base-set install (run 'omedora install' tooling later)."
    return 0
  fi

  log "Resolving the v4 base package set (only missing packages are installed)"
  local base_pkgs=() line
  while IFS= read -r line; do
    line="${line%%#*}"; line="${line//[[:space:]]/}"
    [[ -n $line ]] && base_pkgs+=("$line")
  done <"$payload/install/omarchy-base.packages"
  base_pkgs+=("${fedora_baseline_packages[@]}")

  OMARCHY_PATH="$payload" python3 "$pkg_py" add "${base_pkgs[@]}" ||
    warn "Some base packages could not be installed; re-run 'omarchy update' later to retry."
}

remove_retired_packages() {
  # Re-probe installed-ness: the disclosed list was computed BEFORE the package
  # phase, and the omedora-settings install already swapped hyprland-omedora
  # out via its Obsoletes — dnf5 fails the whole transaction on a
  # no-longer-installed spec.
  local to_remove=() pkg
  for pkg in ${retired_packages[@]+"${retired_packages[@]}"}; do
    rpm -q "$pkg" >/dev/null 2>&1 && to_remove+=("$pkg")
  done
  ((${#to_remove[@]})) || { log "No retired packages to remove"; return 0; }

  log "Removing packages retired from the omedora 4 default install"
  # --noautoremove: never yank shared dependencies out from under other apps.
  if sudo dnf remove --noautoremove -y "${to_remove[@]}"; then
    return 0
  fi
  warn "Batch retired-package removal failed; retrying one by one."
  for pkg in "${to_remove[@]}"; do
    rpm -q "$pkg" >/dev/null 2>&1 || continue
    sudo dnf remove --noautoremove -y "$pkg" ||
      warn "Could not remove retired package '$pkg'; leaving it installed."
  done
}

disable_omedora_3_copr() {
  log "Disabling the 3.8.2-line COPR ($old_copr)"
  sudo dnf -y copr disable "$old_copr" >/dev/null 2>&1 ||
    warn "Could not disable the $old_copr COPR (it may not be enabled); disable it manually with: sudo dnf copr disable $old_copr"
}

enable_omedora_4_copr
install_omedora_4_packages
install_new_base_packages
remove_retired_packages
disable_omedora_3_copr

# --- 3. retired user services (disable now; live processes stop after the new
#        shell is verified, or at reboot) ----------------------------------------

retired_user_units=(
  swayosd-server.service
  elephant.service
  app-walker@autostart.service
  omarchy-battery-monitor.service
  omarchy-battery-monitor.timer
  mako.service
  hyprpolkitagent.service
  omarchy-shell.service
)

user_bus_present() { [[ -S $target_runtime_dir/bus ]]; }

disable_retired_user_units() {
  log "Disabling user services retired by omedora 4"

  if user_bus_present; then
    systemctl --user disable "${retired_user_units[@]}" >/dev/null 2>&1 || true
  fi

  # Retire the unit FILES the 3.8.2 line seeded into ~/.config/systemd/user
  # (backup, never delete) + drop enablement symlinks. The recover-internal-
  # monitor user copy points into the old checkout; v4 ships it under
  # /usr/lib/systemd/user, so the user copy retires too (re-enabled below).
  local base unit link
  for base in "$HOME/.config/systemd/user" "$HOME/.local/share/systemd/user"; do
    [[ -d $base ]] || continue
    for unit in "${retired_user_units[@]}" omarchy-recover-internal-monitor.service; do
      if [[ -f $base/$unit && ! -L $base/$unit ]]; then
        mv -f "$base/$unit" "$base/$unit.$backup_tag.bak"
      else
        rm -f "$base/$unit"
      fi
      for link in "$base"/*.wants/"$unit" "$base"/*.requires/"$unit"; do
        [[ -L $link ]] && rm -f "$link"
      done
    done
    rm -rf "$base/app-walker@autostart.service.d"
  done

  if user_bus_present; then
    systemctl --user daemon-reload >/dev/null 2>&1 || true
  fi
}
disable_retired_user_units

# --- 4. legacy checkout retirement (backup -> symlink, with a live-session
#        Hyprland-conf overlay when needed) --------------------------------------

legacy_hypr_config_active() {
  local hyprland_conf="$HOME/.config/hypr/hyprland.conf"
  [[ -f $hyprland_conf ]] || return 1
  grep -q '\.local/share/omarchy/default/hypr' "$hyprland_conf"
}

hyprland_session_live() {
  pgrep -u "$target_uid" -x Hyprland >/dev/null 2>&1
}

# Fill the overlay's default/hypr with the 3.8.2-line .conf defaults the live
# session still sources. Priority: the just-made local backup (guaranteed to
# match what the session loaded), then a sparse clone of the 3.8.2-omedora
# branch, then the GitHub tarball.
populate_legacy_hypr_defaults() {
  local shim_hypr_dir="$1" backup="$2" tmp_dir clone_dir archive_dir

  rm -rf "$shim_hypr_dir"
  mkdir -p "$shim_hypr_dir"

  if [[ -n $backup && -d $backup/default/hypr ]]; then
    cp -a "$backup/default/hypr/." "$shim_hypr_dir/"
  fi

  if ! find "$shim_hypr_dir" -type f -name '*.conf' -print -quit | grep -q .; then
    tmp_dir=$(mktemp -d)
    clone_dir="$tmp_dir/omedora"
    if command -v git >/dev/null 2>&1; then
      if git clone --depth 1 --branch 3.8.2-omedora --single-branch --filter=blob:none --sparse \
           https://github.com/AndrewGaspar/omedora.git "$clone_dir" >/dev/null 2>&1 &&
         git -C "$clone_dir" sparse-checkout set default/hypr >/dev/null 2>&1 &&
         [[ -d $clone_dir/default/hypr ]]; then
        cp -a "$clone_dir/default/hypr/." "$shim_hypr_dir/"
      fi
    fi
    if ! find "$shim_hypr_dir" -type f -name '*.conf' -print -quit | grep -q .; then
      archive_dir="$tmp_dir/archive"
      mkdir -p "$archive_dir"
      if command -v curl >/dev/null 2>&1 && command -v tar >/dev/null 2>&1 &&
         curl -fsSL https://github.com/AndrewGaspar/omedora/archive/refs/heads/3.8.2-omedora.tar.gz |
           tar -xz -C "$archive_dir" 2>/dev/null; then
        if [[ -d $archive_dir/omedora-3.8.2-omedora/default/hypr ]]; then
          cp -a "$archive_dir/omedora-3.8.2-omedora/default/hypr/." "$shim_hypr_dir/"
        fi
      fi
    fi
    rm -rf "$tmp_dir"
  fi

  find "$shim_hypr_dir" -type f -name '*.conf' -print -quit | grep -q .
}

create_live_omarchy_overlay() {
  local backup="$1" compat_root shim_hypr_dir entry base cleanup_hook

  compat_root="$HOME/.local/state/omarchy/upgrade-to-4-live-omarchy"
  shim_hypr_dir="$HOME/.local/state/omarchy/upgrade-to-4-hypr-defaults"

  populate_legacy_hypr_defaults "$shim_hypr_dir" "$backup" || return 1

  rm -rf "$compat_root"
  mkdir -p "$compat_root/default"

  shopt -s dotglob nullglob
  for entry in "$payload"/* "$payload"/.[!.]* "$payload"/..?*; do
    [[ -e $entry ]] || continue
    base=$(basename "$entry")
    [[ $base == default ]] && continue
    ln -s "$entry" "$compat_root/$base"
  done
  for entry in "$payload"/default/* "$payload"/default/.[!.]* "$payload"/default/..?*; do
    [[ -e $entry ]] || continue
    base=$(basename "$entry")
    [[ $base == hypr ]] && continue
    ln -s "$entry" "$compat_root/default/$base"
  done
  shopt -u dotglob nullglob
  ln -s "$shim_hypr_dir" "$compat_root/default/hypr"

  cleanup_hook="$HOME/.config/omarchy/hooks/post-boot.d/cleanup-upgrade-to-4-live-shim"
  mkdir -p "$(dirname "$cleanup_hook")"
  cat >"$cleanup_hook" <<CLEANUP_HOOK
#!/bin/bash
set -euo pipefail
legacy_root="\$HOME/.local/share/omarchy"
compat_root="$compat_root"
shim_hypr_dir="$shim_hypr_dir"
if [[ -L \$legacy_root && \$(readlink "\$legacy_root") == "\$compat_root" ]]; then
  ln -sfn /usr/share/omarchy "\$legacy_root"
fi
rm -rf "\$compat_root" "\$shim_hypr_dir"
rm -f "\$0"
CLEANUP_HOOK
  chmod +x "$cleanup_hook"

  printf '%s\n' "$compat_root"
}

retire_legacy_checkout() {
  log "Retiring the legacy git checkout (backup: $legacy_backup)"
  mkdir -p "$HOME/.local/share"

  local backup=""
  if [[ -L $legacy_root ]]; then
    rm -f "$legacy_root"
  elif [[ -e $legacy_root ]]; then
    mv "$legacy_root" "$legacy_backup"
    backup="$legacy_backup"
  fi

  # The live-session overlay shim: only when (a) the user's hyprland.conf still
  # sources the legacy .conf defaults AND (b) a Hyprland session is actually
  # running — a reboot/fresh login uses the v4 Lua config and never needs it.
  if legacy_hypr_config_active && hyprland_session_live; then
    local compat_root
    if compat_root=$(create_live_omarchy_overlay "$backup"); then
      ln -sfn "$compat_root" "$legacy_root"
      log "Live session detected: ~/.local/share/omarchy points at a temporary overlay keeping your current Hyprland .conf session alive until logout"
    else
      warn "Could not prepare the legacy Hyprland conf shim; linking ~/.local/share/omarchy directly to /usr/share/omarchy."
      ln -sfn /usr/share/omarchy "$legacy_root"
    fi
  else
    ln -sfn /usr/share/omarchy "$legacy_root"
  fi

  # Remove stale ~/.local/bin shims pointing into the old clone.
  local local_bin="$HOME/.local/bin" link target
  if [[ -d $local_bin ]]; then
    shopt -s nullglob
    for link in "$local_bin"/omarchy* "$local_bin"/omedora*; do
      [[ -L $link ]] || continue
      target=$(readlink "$link" || true)
      case "$target" in
        "$legacy_root"/bin/*|../share/omarchy/bin/*|*.local/share/omarchy/bin/*) rm -f "$link" ;;
      esac
    done
    shopt -u nullglob
  fi
}
retire_legacy_checkout

# --- 5. user transition (the hash-match engine) ----------------------------------

backup_config_file() {
  local file="$1"
  [[ -e $file || -L $file ]] || return 0
  cp -af "$file" "$file.$backup_tag.bak"
}

# Backup-then-write a single payload config file into ~/.config.
copy_config_default() {
  local rel="$1" source="$payload/config/$1" target="$HOME/.config/$1"
  [[ -e $source || -L $source ]] || return 0
  [[ $rel == git/config ]] && return 0   # protected: the user's git identity

  if [[ -e $target || -L $target ]]; then
    if [[ -f $source && -f $target ]] && cmp -s "$source" "$target"; then
      return 0
    fi
    backup_config_file "$target"
    rm -f "$target"
  fi

  mkdir -p "$(dirname "$target")"
  cp -P "$source" "$target"
}

# Backup-then-write an arbitrary file from the payload (branding, toggles, ...).
seed_payload_file() {
  local source="$1" target="$2"
  [[ -f $source ]] || return 0
  if [[ -e $target || -L $target ]]; then
    if [[ -f $target ]] && cmp -s "$source" "$target"; then
      return 0
    fi
    backup_config_file "$target"
    rm -f "$target"
  fi
  mkdir -p "$(dirname "$target")"
  cp -f "$source" "$target"
}

migrate_uwsm_env_customizations() {
  local source="$1" dest="$HOME/.config/uwsm/env.d/99-omarchy-upgrade-env" tmp
  [[ -f $source ]] || return 0
  is_known_default_hash retire uwsm/env "$source" && return 0

  tmp=$(mktemp)
  awk '
    function omitted(reason) { print ": # omedora-upgrade omitted legacy omedora " reason; next }

    /^[[:space:]]*export[[:space:]]+OMARCHY_PATH=\$HOME\/\.local\/share\/omarchy[[:space:]]*$/ { omitted("OMARCHY_PATH") }
    /^[[:space:]]*export[[:space:]]+OMARCHY_PATH="\$\{OMARCHY_PATH:-\/usr\/share\/omarchy\}"[[:space:]]*$/ { omitted("OMARCHY_PATH") }
    /^[[:space:]]*\[ -f \/etc\/omarchy\.conf \] && \. \/etc\/omarchy\.conf[[:space:]]*$/ { omitted("/etc/omarchy.conf source") }
    /^[[:space:]]*export[[:space:]]+PATH=\$OMARCHY_PATH\/bin:\$PATH:\$HOME\/\.local\/bin[[:space:]]*$/ { omitted("PATH setup") }
    /^[[:space:]]*export[[:space:]]+PATH="\$OMARCHY_PATH\/bin:\$PATH:\$HOME\/\.local\/bin"[[:space:]]*$/ { omitted("PATH setup") }
    /^[[:space:]]*source[[:space:]]+~\/\.config\/uwsm\/default[[:space:]]*$/ { omitted("uwsm/default source") }
    /^[[:space:]]*\[ -f "\$HOME\/\.config\/uwsm\/default" \] && \. "\$HOME\/\.config\/uwsm\/default"[[:space:]]*$/ { omitted("uwsm/default source") }
    /^[[:space:]]*omarchy-cmd-present[[:space:]]+mise && eval "\$\(mise activate bash --shims\)"[[:space:]]*$/ { omitted("mise activation") }

    { print }
  ' "$source" >"$tmp"

  if [[ -s $tmp ]]; then
    if ! sh -n "$tmp" >/dev/null 2>&1; then
      cp -f "$source" "$tmp"
    fi
    mkdir -p "$(dirname "$dest")"
    {
      echo '# Preserved custom ~/.config/uwsm/env content during the omedora 4 upgrade.'
      echo '# Exact legacy omedora-managed setup lines were replaced with no-op markers where safe.'
      cat "$tmp"
    } >"$dest"
  fi

  rm -f "$tmp"
}

apply_user_transition() {
  log "Applying the omedora 4 user transition"
  [[ -d $payload ]] || fail "$payload was not installed."

  local state_dir="$HOME/.local/state/omarchy"
  mkdir -p "$state_dir" "$HOME/.config"

  local -a retired_config_files=()
  mapfile -t retired_config_files < <(default_hash_paths retire)

  is_retired_config_file() {
    local rel="$1" retired
    [[ $rel == systemd/user/* ]] && return 0
    for retired in "${retired_config_files[@]}"; do
      [[ $rel == "$retired" ]] && return 0
    done
    return 1
  }

  # uwsm env: was hardcoded to the legacy checkout — back up, migrate customs.
  local uwsm_env="$HOME/.config/uwsm/env"
  if [[ -f $uwsm_env ]]; then
    cp -f "$uwsm_env" "$uwsm_env.$backup_tag.bak"
    migrate_uwsm_env_customizations "$uwsm_env"
  fi

  local rel file backup
  for rel in "${retired_config_files[@]}"; do
    backup_config_file "$HOME/.config/$rel"
  done

  # Refresh files whose hash matches a default omedora/omarchy has shipped;
  # fill in missing defaults; always write the v4-only entry points.
  while IFS= read -r rel; do
    file="$HOME/.config/$rel"
    [[ -f $file && -f $payload/config/$rel ]] || continue
    is_known_default_hash refresh "$rel" "$file" || continue
    copy_config_default "$rel"
  done < <(default_hash_paths refresh)

  local source_path rel_path target_path
  while IFS= read -r -d '' source_path; do
    rel_path="${source_path#"$payload"/config/}"
    is_retired_config_file "$rel_path" && continue
    [[ $rel_path == git/config ]] && continue
    target_path="$HOME/.config/$rel_path"
    [[ -e $target_path || -L $target_path ]] && continue
    mkdir -p "$(dirname "$target_path")"
    cp -P "$source_path" "$target_path"
  done < <(find "$payload/config" \( -type f -o -type l \) -print0)

  for rel in "${always_copy_config_files[@]}"; do
    copy_config_default "$rel"
  done

  # Chromium copy-url extension flags still pointing into the old clone.
  local flag_file
  for flag_file in chromium-flags.conf chrome-flags.conf google-chrome-flags.conf \
      google-chrome-stable-flags.conf brave-flags.conf brave-browser-flags.conf \
      microsoft-edge-flags.conf microsoft-edge-stable-flags.conf opera-flags.conf \
      vivaldi-flags.conf helium-flags.conf; do
    file="$HOME/.config/$flag_file"
    [[ -f $file ]] || continue
    grep -qF '.local/share/omarchy/default/chromium/extensions/copy-url' "$file" || continue
    backup_config_file "$file"
    sed -i \
      -e "s|~/.local/share/omarchy/default/chromium/extensions/copy-url|/usr/share/omarchy/default/chromium/extensions/copy-url|g" \
      -e "s|\$HOME/.local/share/omarchy/default/chromium/extensions/copy-url|/usr/share/omarchy/default/chromium/extensions/copy-url|g" \
      -e "s|$HOME/.local/share/omarchy/default/chromium/extensions/copy-url|/usr/share/omarchy/default/chromium/extensions/copy-url|g" \
      "$file"
  done

  # Carry over user-added theme backgrounds from the checkout backup, then drop
  # ~/.config/omarchy/themes symlinks into the pre-4 checkout (v4 reads stock
  # themes from /usr/share/omarchy/themes).
  if [[ -d $legacy_backup/themes && -d $legacy_backup/.git ]]; then
    (
      cd "$legacy_backup"
      mapfile -t tracked_backgrounds < <(git ls-files --cached 'themes/*/backgrounds/*' 2>/dev/null || true)
      for theme_dir in themes/*/; do
        [[ -d $theme_dir/backgrounds ]] || continue
        theme_name=$(basename "$theme_dir")
        for bg_file in "$theme_dir"backgrounds/*; do
          [[ -f $bg_file ]] || continue
          is_tracked=0
          for tracked in ${tracked_backgrounds[@]+"${tracked_backgrounds[@]}"}; do
            [[ $tracked == "$bg_file" ]] && { is_tracked=1; break; }
          done
          if (( ! is_tracked )); then
            mkdir -p "$HOME/.config/omarchy/backgrounds/$theme_name"
            mv "$bg_file" "$HOME/.config/omarchy/backgrounds/$theme_name/"
          fi
        done
      done
    ) || true
  fi
  if [[ -d $HOME/.config/omarchy/themes ]]; then
    find "$HOME/.config/omarchy/themes" -mindepth 1 -maxdepth 1 -type l -delete
  fi

  # Legacy UI configs replaced by the Quickshell shell: moved aside, never rm'd.
  # Hyprland .conf files are intentionally left in place for reference.
  for rel in "${retired_config_dirs[@]}"; do
    file="$HOME/.config/$rel"
    if [[ -e $file || -L $file ]]; then
      backup="$file.$backup_tag.bak"
      rm -rf "$backup"
      mv "$file" "$backup"
    fi
  done

  # Retire package-owned config files: hash-matched copies are removed (the
  # package path takes over); customized copies stay active as overrides.
  for rel in "${retired_config_files[@]}"; do
    file="$HOME/.config/$rel"
    backup="$file.$backup_tag.bak"

    if [[ $rel == uwsm/env ]]; then
      rm -f "$file"   # custom lines were migrated to uwsm/env.d above
      continue
    fi

    if [[ -f $backup ]] && ! is_known_default_hash retire "$rel" "$backup"; then
      mkdir -p "$(dirname "$file")"
      cp -af "$backup" "$file"
    else
      rm -f "$file"
    fi
  done

  # Agent skill symlinks (same set the v4 finalize creates).
  if [[ -d $payload/default/omarchy-skill ]]; then
    mkdir -p "$HOME/.agents/skills" "$HOME/.claude/skills" "$HOME/.codex/skills" "$HOME/.pi/agent/skills"
    ln -sfn "$payload/default/omarchy-skill" "$HOME/.agents/skills/omarchy"
    ln -sfn "$payload/default/omarchy-skill" "$HOME/.claude/skills/omarchy"
    ln -sfn "$payload/default/omarchy-skill" "$HOME/.codex/skills/omarchy"
    ln -sfn "$payload/default/omarchy-skill" "$HOME/.pi/agent/skills/omarchy"
  fi

  # v4 toggle state. Legacy .conf entry points source toggles/hypr/*.conf —
  # keep an empty match for the live pre-reboot session; v4 Lua ignores it.
  mkdir -p "$state_dir/toggles/hypr"
  seed_payload_file "$payload/default/hypr/toggles/flags.lua" "$state_dir/toggles/hypr/flags.lua"
  if [[ -f $HOME/.config/hypr/hyprland.conf ]]; then
    : >"$state_dir/toggles/hypr/flags.conf"
  fi
  rm -f \
    "$state_dir/toggles/mako.ini" \
    "$state_dir/toggles/waybar-off" \
    "$state_dir/toggles/hyprlock.conf" \
    "$state_dir/toggles/lock.conf"

  # Nautilus extensions + branding text (backup-then-write).
  local extension
  for extension in localsend.py transcode.py; do
    seed_payload_file "$payload/default/nautilus-python/extensions/$extension" \
      "$HOME/.local/share/nautilus-python/extensions/$extension"
  done
  seed_payload_file "$payload/icon.txt" "$HOME/.config/omarchy/branding/about.txt"
  seed_payload_file "$payload/logo.txt" "$HOME/.config/omarchy/branding/screensaver.txt"

  # ~/.XCompose: only when absent (matches the v4 install's backup-then-write
  # gate; an existing file — 3.8.2's or the user's — is left alone).
  if [[ ! -f $HOME/.XCompose ]]; then
    cat >"$HOME/.XCompose" <<EOF
# Run omarchy-restart-xcompose to apply changes

# Include fast emoji access
include "/usr/share/omarchy/default/xcompose"
EOF
  fi

  # Theme plumbing: btop theme symlink + a current background if none chosen.
  mkdir -p "$HOME/.config/omarchy/themes" "$HOME/.config/btop/themes"
  ln -snf "$HOME/.config/omarchy/current/theme/btop.theme" "$HOME/.config/btop/themes/current.theme"

  # Wireplumber bluetooth autoconnect (v4 default; backup-then-write).
  seed_payload_file \
    "$payload/default/wireplumber/wireplumber.conf.d/bluetooth-a2dp-autoconnect.conf" \
    "$HOME/.config/wireplumber/wireplumber.conf.d/bluetooth-a2dp-autoconnect.conf"

  # Enable the v4 user units (static symlinks — no session bus required).
  enable_user_unit() {
    local unit="$1" unit_path link_target target
    local -a targets=()

    if [[ -f $HOME/.config/systemd/user/$unit ]]; then
      unit_path="$HOME/.config/systemd/user/$unit"
      link_target="../$unit"
    elif [[ -f /usr/lib/systemd/user/$unit ]]; then
      unit_path="/usr/lib/systemd/user/$unit"
      link_target="$unit_path"
    elif [[ -f $payload/default/systemd/user/$unit ]]; then
      unit_path="$payload/default/systemd/user/$unit"
      link_target="$unit_path"
    else
      return 0
    fi

    mapfile -t targets < <(awk -F= '
      /^\[Install\]/ { in_install=1; next }
      /^\[/ { in_install=0 }
      in_install && $1 == "WantedBy" {
        n=split($2, values, /[[:space:]]+/)
        for (i = 1; i <= n; i++) if (values[i] != "") print values[i]
      }
    ' "$unit_path")
    ((${#targets[@]})) || targets=(default.target)
    for target in "${targets[@]}"; do
      mkdir -p "$HOME/.config/systemd/user/$target.wants"
      ln -sfn "$link_target" "$HOME/.config/systemd/user/$target.wants/$unit"
    done
  }
  enable_user_unit bt-agent.service
  enable_user_unit omarchy-sleep-lock.service
  enable_user_unit omarchy-recover-internal-monitor.service
  if user_bus_present; then
    systemctl --user daemon-reload >/dev/null 2>&1 || true
    systemctl --user reset-failed omarchy-sleep-lock.service >/dev/null 2>&1 || true
    systemctl --user start omarchy-sleep-lock.service >/dev/null 2>&1 || true
  fi

  # Refresh the shipped .desktop launchers (cp -f: omarchy-owned entries).
  mkdir -p "$HOME/.local/share/applications"
  rm -f "$HOME/.config/autostart/walker.desktop"
  if [[ -d $payload/applications ]]; then
    find "$payload/applications" -maxdepth 1 -type f -name '*.desktop' \
      -exec cp -f {} "$HOME/.local/share/applications/" \;
  fi
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
  fi

  # NOTE: default browser / mailto handlers / mimeapps are NOT touched here —
  # the 3.8.2 install already claimed them only-if-unset, and the user's
  # current choices stand (omedora policy; upstream sets them unconditionally).

  touch "$state_dir/finalize-user.done"
}
apply_user_transition

# --- 6. system transition (root; Fedora-gated by the installed payload) ----------

apply_system_transition() {
  log "Applying the omedora 4 system transition (omarchy-setup-system --upgrade)"
  if [[ ! -x /usr/bin/omarchy-setup-system && ! -x $payload/bin/omarchy-setup-system ]]; then
    warn "omarchy-setup-system not found; skipping the system transition."
    return 0
  fi
  # Every script inside is Fedora-gated or dispatched (see omedora/
  # architecture.md §16): lock-screen PAM (new omarchy-namespaced service
  # only), docker group + daemon.json only-if-absent, firewalld rules,
  # service enables for installed components. No SDDM, no limine, no
  # plymouth, no faillock, no GDM changes.
  sudo env OMARCHY_LOG_TO_STDOUT=1 PATH="$package_path" \
    omarchy-setup-system --install-user "$target_user" --upgrade ||
    warn "omarchy-setup-system reported errors; review the output above (re-run: sudo omarchy-setup-system --install-user $target_user --upgrade)."
}
apply_system_transition

# --- 7. theme refresh (regenerate theme-generated config with v4 templates) ------

write_legacy_theme_hyprland_conf() {
  # The legacy ~/.config/hypr/hyprland.conf sources current/theme/hyprland.conf.
  # v4 theme-set no longer generates it; write a minimal one so live-session
  # reloads before logout don't error.
  local hyprland_conf="$HOME/.config/hypr/hyprland.conf"
  [[ -f $hyprland_conf ]] || return 0
  grep -q 'current/theme/hyprland.conf' "$hyprland_conf" || return 0

  local theme_dir="$HOME/.config/omarchy/current/theme"
  local colors="$theme_dir/colors.toml" target="$theme_dir/hyprland.conf"
  mkdir -p "$theme_dir"
  local accent="7aa2f7" parsed
  if [[ -f $colors ]]; then
    parsed=$(awk -F= '/^[[:space:]]*accent[[:space:]]*=/ { gsub(/[[:space:]"#]/, "", $2); print $2; exit }' "$colors")
    [[ -n ${parsed:-} ]] && accent="$parsed"
  fi
  {
    printf '$activeBorderColor = rgb(%s)\n\n' "$accent"
    cat <<'EOF'
general {
    col.active_border = $activeBorderColor
}

group {
    col.border_active = $activeBorderColor
}
EOF
  } >"$target"
}

refresh_current_theme_after_upgrade() {
  local theme_name="" runtime_dir
  if [[ -f $HOME/.config/omarchy/current/theme.name ]]; then
    read -r theme_name <"$HOME/.config/omarchy/current/theme.name" || true
  elif [[ -L $HOME/.config/omarchy/current/theme ]]; then
    theme_name=$(basename -- "$(readlink "$HOME/.config/omarchy/current/theme")")
  fi
  theme_name=${theme_name//$'\r'/}; theme_name=${theme_name//$'\n'/}
  [[ -n $theme_name ]] || theme_name="Tokyo Night"

  log "Refreshing the current theme with omedora 4 templates ($theme_name)"
  runtime_dir="$target_runtime_dir"
  [[ -d $runtime_dir ]] || runtime_dir=/tmp

  if ! env \
    XDG_RUNTIME_DIR="$runtime_dir" \
    OMARCHY_PATH="$payload" \
    OMARCHY_THEME_HEADLESS=1 \
    PATH="$package_path" \
    omarchy-theme-set "$theme_name"; then
    warn "Could not refresh theme '$theme_name'. Run 'omarchy theme set \"$theme_name\"' after reboot if theme-dependent config looks stale."
  fi

  write_legacy_theme_hyprland_conf

  if [[ ! -e $HOME/.config/omarchy/current/background && -d $HOME/.config/omarchy/current/theme/backgrounds ]]; then
    local background
    background=$(find "$HOME/.config/omarchy/current/theme/backgrounds" -maxdepth 1 -type f \
      \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | sort | head -n1)
    [[ -n ${background:-} ]] && ln -snf "$background" "$HOME/.config/omarchy/current/background"
  fi

  # Poke terminals so the active upgrade terminal picks up regenerated files.
  env OMARCHY_PATH="$payload" PATH="$package_path" \
    omarchy-restart-terminal >/dev/null 2>&1 || true
}
refresh_current_theme_after_upgrade

# --- 8. quickshell hot-start (keep the live session usable until reboot) ---------

valid_wayland_display() { [[ -n ${1:-} && -S $target_runtime_dir/$1 ]]; }

discover_wayland_display() {
  local candidate pid
  candidate="${WAYLAND_DISPLAY:-}"
  valid_wayland_display "$candidate" && { printf '%s\n' "$candidate"; return 0; }

  pid=$(pgrep -u "$target_uid" -x Hyprland 2>/dev/null | head -n1 || true)
  if [[ -n $pid && -r /proc/$pid/environ ]]; then
    candidate=$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null |
      sed -n 's/^WAYLAND_DISPLAY=//p' | head -n1 || true)
    valid_wayland_display "$candidate" && { printf '%s\n' "$candidate"; return 0; }
  fi

  local candidates=()
  mapfile -t candidates < <(find "$target_runtime_dir" -maxdepth 1 -type s -name 'wayland-*' -printf '%f\n' 2>/dev/null || true)
  (( ${#candidates[@]} == 1 )) || return 1
  printf '%s\n' "${candidates[0]}"
}

valid_hyprland_signature() {
  [[ -n ${1:-} ]] || return 1
  [[ -S $target_runtime_dir/hypr/$1/.socket.sock || -S $target_runtime_dir/hypr/$1/.socket2.sock ]]
}

discover_hyprland_signature() {
  local candidate pid
  candidate="${HYPRLAND_INSTANCE_SIGNATURE:-}"
  valid_hyprland_signature "$candidate" && { printf '%s\n' "$candidate"; return 0; }

  pid=$(pgrep -u "$target_uid" -x Hyprland 2>/dev/null | head -n1 || true)
  if [[ -n $pid && -r /proc/$pid/environ ]]; then
    candidate=$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null |
      sed -n 's/^HYPRLAND_INSTANCE_SIGNATURE=//p' | head -n1 || true)
    valid_hyprland_signature "$candidate" && { printf '%s\n' "$candidate"; return 0; }
  fi

  local candidates=()
  mapfile -t candidates < <(find "$target_runtime_dir/hypr" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null || true)
  (( ${#candidates[@]} == 1 )) || return 1
  printf '%s\n' "${candidates[0]}"
}

start_omarchy_shell_session() {
  # omedora 4 starts Quickshell from Hyprland autostart. Reboot is the real
  # cutover, but start the new shell in the current session when possible so
  # the user isn't left without a bar once waybar/walker/mako are stopped.
  local quickshell_bin omarchy_shell_bin shell_log
  hyprland_session_live || { log "No live Hyprland session; the Omedora shell will start at your next login."; return 1; }
  quickshell_bin=$(command -v quickshell || true)
  [[ -n $quickshell_bin ]] || { warn "quickshell is not available; the Omedora shell will start after reboot."; return 1; }
  omarchy_shell_bin=/usr/bin/omarchy-shell
  [[ -x $omarchy_shell_bin ]] || omarchy_shell_bin=$(command -v omarchy-shell || true)
  [[ -n $omarchy_shell_bin ]] || { warn "omarchy-shell is not available; the Omedora shell will start after reboot."; return 1; }
  [[ -f $payload/shell/shell.qml ]] || { warn "$payload/shell is missing; the Omedora shell will start after reboot."; return 1; }
  [[ -d $target_runtime_dir ]] || { warn "No running user session found; the Omedora shell will start after reboot."; return 1; }

  shell_log="$HOME/.local/state/omarchy/omarchy-shell-upgrade.log"
  mkdir -p "$HOME/.local/state/omarchy" 2>/dev/null || true

  local wayland_display hyprland_signature
  wayland_display=$(discover_wayland_display || true)
  [[ -n $wayland_display ]] || { warn "No Wayland display found; the Omedora shell will start after reboot."; return 1; }
  hyprland_signature=$(discover_hyprland_signature || true)
  [[ -n $hyprland_signature ]] || { warn "No Hyprland session found; the Omedora shell will start after reboot."; return 1; }

  log "Starting the Omedora shell in the current session"
  env \
    XDG_RUNTIME_DIR="$target_runtime_dir" \
    WAYLAND_DISPLAY="$wayland_display" \
    HYPRLAND_INSTANCE_SIGNATURE="$hyprland_signature" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$target_runtime_dir/bus" \
    XDG_CURRENT_DESKTOP=Hyprland \
    XDG_SESSION_DESKTOP=Hyprland \
    XDG_SESSION_TYPE=wayland \
    QT_QPA_PLATFORM=wayland \
    GDK_BACKEND=wayland,x11,* \
    DESKTOP_SESSION=hyprland \
    OMARCHY_PATH="$payload" \
    PATH="$package_path" \
    bash -c '
      omarchy_shell_bin=$1
      quickshell_bin=$2
      shell_log=$3
      payload=$4
      if [[ $("$omarchy_shell_bin" lock isLocked 2>/dev/null || true) == "true" ]]; then
        exit 2
      fi
      pkill -x quickshell 2>/dev/null || true
      sleep 0.2
      : >"$shell_log"
      setsid "$quickshell_bin" -n -p "$payload/shell" >>"$shell_log" 2>&1 &
    ' bash "$omarchy_shell_bin" "$quickshell_bin" "$shell_log" "$payload" ||
    { warn "Could not start the Omedora shell in the current session; it will start after reboot. See $shell_log"; return 1; }

  local attempt
  for attempt in {1..60}; do
    if env \
      XDG_RUNTIME_DIR="$target_runtime_dir" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=$target_runtime_dir/bus" \
      OMARCHY_PATH="$payload" \
      PATH="$package_path" \
      "$omarchy_shell_bin" shell ping >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done

  warn "The Omedora shell did not respond in the current session; it will start after reboot. See $shell_log"
  return 1
}

stop_retired_session_processes() {
  log "Stopping retired 3.8.2-line session processes"
  if user_bus_present; then
    systemctl --user stop "${retired_user_units[@]}" >/dev/null 2>&1 || true
  fi
  pkill -x waybar >/dev/null 2>&1 || true
  pkill -x walker >/dev/null 2>&1 || true
  pkill -x elephant >/dev/null 2>&1 || true
  pkill -x mako >/dev/null 2>&1 || true
  pkill -x swayosd-server >/dev/null 2>&1 || true
  if user_bus_present; then
    systemctl --user daemon-reload >/dev/null 2>&1 || true
  fi
}

if start_omarchy_shell_session; then
  stop_retired_session_processes
else
  if hyprland_session_live; then
    warn "Leaving the retired 3.8.2-line session processes (waybar/walker/mako) running until reboot."
  fi
fi

# --- 9. wrap-up -------------------------------------------------------------------

cat <<EOF

$(printf '\033[32m')Omedora 4 upgrade complete.$(printf '\033[0m')

  • Updates are now package-driven: run 'omarchy update' (or plain 'sudo dnf upgrade').
  • Your old git checkout is preserved at:
      $legacy_backup
  • Every replaced config file has a sibling backup: <file>.$backup_tag(.bak)
  • At the GDM login screen, the session is still called "Omedora".

IMPORTANT: review the output above before rebooting. If there are errors, fix
them (or ask for help) first. A reboot/relogin completes the switch to the
package-backed Omedora 4 session.
EOF

if (( auto_reboot )); then
  log "Rebooting because --reboot was passed"
  sudo systemctl reboot
elif [[ -n $PROMPT_TTY ]]; then
  prompt_stdin read -r -p $'\nReboot now? [y/N] ' reboot_answer || reboot_answer=""
  if [[ $reboot_answer =~ ^[Yy]([Ee][Ss])?$ ]]; then
    sudo systemctl reboot
  else
    echo "Not rebooting. Please reboot manually after confirming there were no errors."
  fi
else
  echo "No TTY available for the reboot prompt. Please reboot manually after confirming there were no errors."
fi
