#!/bin/bash

# omarchy:summary=Upgrade a 3.8.2-line git-clone omedora install to the package-backed omedora 4 layout.
# omarchy:args=[--yes] [--reboot] [--user USER]
# omarchy:examples=omedora upgrade to 4 | omedora-upgrade-to-4 --yes --reboot
# omarchy:requires-sudo=true

# In-place upgrade: omedora v0.1.x (the 3.8.2-omedora line: a git clone at
# ~/.local/share/omarchy + RPMs from the agaspar/omedora-3 COPR) -> omedora 4
# (the omedora/omedora-settings RPMs from agaspar/omedora-4, payload at
# /usr/share/omarchy, Quickshell shell replacing waybar/walker/mako/swayosd).
#
# Adapted function-by-function from upstream's bin/omarchy-upgrade-to-4 (the
# Arch 3.8.x -> 4 upgrader), with omedora's coexistence contract on top:
#   - ONE plan gate up front that discloses EVERYTHING before any change
#     (the omedora/install/plan.sh idiom, incl. the /dev/tty-only prompt rule)
#   - backup-then-write everywhere: every user file that exists and differs
#     from a KNOWN SHIPPED DEFAULT (upstream's hash table — verified to cover
#     the 3.8.2-omedora-shipped variants byte-for-byte) is backed up to
#     <file>.pre-omedora-4-<ts> before being replaced; customized files stay
#     ACTIVE (hash-mismatch == never refreshed)
#   - never touched: /etc/os-release, nsswitch, faillock, existing pam.d
#     files, GDM config, bootloader, initramfs, ~/.bashrc (the 3.8.2 sentinel
#     block keeps working through the ~/.local/share/omarchy compat symlink)
#   - no SDDM/limine/plymouth (upstream Arch concerns; GDM stays)
#
# Intentionally SELF-CONTAINED (no sourcing from the omedora checkout): it can
# ship inside a 3.8.2-line install whose tree predates it, or run via
# `curl | bash`. It also survives executing FROM the dying checkout: the
# checkout retirement renames (mv) the tree, which keeps this script's open
# inode valid; as belt-and-braces we re-exec from a temp copy when invoked
# from inside ~/.local/share/omarchy.
#
# Test seams (mirroring omedora/install/plan.sh):
#   OMEDORA_PLAN_AUTOCONFIRM=1   print the plan and proceed without prompting
#   OMEDORA_SNAPSHOT=1           pre-answer the snapshot offer
#   OMEDORA_DNF_CMD              dnf used for read-only queries (mockable)
#   OMEDORA_UPGRADE_PAYLOAD      installed-payload root (default /usr/share/omarchy)
#   OMEDORA_UPGRADE_EUID         override the EUID seen by the root guard
#   OMEDORA_OS_RELEASE           override /etc/os-release for the distro guard
#   OMEDORA_COPR_OWNER           COPR owner (default agaspar)

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: omedora-upgrade-to-4 [--yes] [--reboot] [--user USER]

Upgrade a 3.8.2-line (git-clone, omedora v0.1.x) install to the package-backed
omedora 4 layout. Self-contained: can run from an old checkout or via curl|bash.

Options:
  -y, --yes        Do not prompt before upgrading (the plan still prints)
  --reboot         Reboot automatically after a successful upgrade
  --user USER      Must name the invoking user (accepted for upstream parity)
  --channel NAME   Accepted and ignored: omedora has a single package channel
  --dev            Accepted and ignored: omedora has no stop-gap dev repo
  -h, --help       Show this help
USAGE
}

log()  { printf '\033[32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33mWarning:\033[0m %s\n' "$*" >&2; }
fail() { printf '\033[31mError:\033[0m %s\n' "$*" >&2; exit 1; }

yes=0
auto_reboot=0
arg_user=""

while (($#)); do
  case "$1" in
    -y|--yes) yes=1; shift ;;
    --reboot) auto_reboot=1; shift ;;
    --user) arg_user="${2:-}"; shift 2 ;;
    --channel)
      log "omedora has a single package channel (the omedora-4 COPR); ignoring --channel ${2:-}"
      shift 2
      ;;
    --dev)
      log "omedora has no stop-gap dev repo; ignoring --dev"
      shift
      ;;
    -h|--help) usage; exit 0 ;;
    *) fail "Unknown option: $1" ;;
  esac
done

# --- guards -------------------------------------------------------------------

os_release="${OMEDORA_OS_RELEASE:-/etc/os-release}"
if [[ ! -r $os_release ]] || ! grep -q '^ID=fedora' "$os_release"; then
  fail "This upgrade is only supported on Fedora (no ID=fedora in $os_release)."
fi

if [[ $(uname -m) != "x86_64" ]]; then
  fail "This upgrade requires x86_64 (got $(uname -m))."
fi

effective_euid="${OMEDORA_UPGRADE_EUID:-$EUID}"
if (( effective_euid == 0 )); then
  fail "Run this as your regular user, not root (sudo is used internally where needed)."
fi

target_user="${USER:-$(id -un)}"
if [[ -n $arg_user && $arg_user != "$target_user" ]]; then
  fail "--user must name the invoking user ($target_user). Log in as '$arg_user' and re-run."
fi

# sudo guard, tty-aware (the omedora/install-4.sh idiom): on an interactive
# terminal `sudo -v` prompts once and caches; without a tty it can't prompt,
# and Fedora's passworded %wheel makes `sudo -v` demand a password even when a
# NOPASSWD rule also matches — so probe with `sudo -n true` instead.
sudo_ok() {
  command -v sudo >/dev/null 2>&1 || return 1
  if [[ -t 0 ]]; then sudo -v; else sudo -n true; fi
}
sudo_ok || fail "This upgrade requires working sudo for $target_user."

legacy_root="$HOME/.local/share/omarchy"

if [[ -L $legacy_root ]]; then
  echo "omedora 4 is already in place (~/.local/share/omarchy is a symlink to $(readlink "$legacy_root")). Nothing to do."
  exit 0
fi
if rpm -q omedora >/dev/null 2>&1 && [[ ! -e $legacy_root ]]; then
  echo "omedora 4 is already installed (the omedora package is present and no legacy checkout exists). Nothing to do."
  exit 0
fi
if [[ ! -d $legacy_root/.git ]]; then
  fail "No 3.8.2-line omedora install found (~/.local/share/omarchy is not a git checkout). Fresh installs: see omedora/boot.sh."
fi

# --- survive running from the dying checkout ----------------------------------
# If this very file lives inside ~/.local/share/omarchy (the tree we are about
# to rename), re-exec from a temp copy so nothing later can yank our text. A
# plain rename keeps the open inode valid, but a re-clone/cleanup would not.
if [[ -z ${OMEDORA_UPGRADE_REEXEC:-} && -f $0 ]]; then
  self_path=$(readlink -f "$0" 2>/dev/null || true)
  if [[ -n $self_path && $self_path == "$legacy_root"/* ]]; then
    tmp_self=$(mktemp /tmp/omedora-upgrade-to-4.XXXXXX)
    cp -f "$self_path" "$tmp_self"
    chmod +x "$tmp_self"
    args=()
    (( yes )) && args+=(--yes)
    (( auto_reboot )) && args+=(--reboot)
    exec env OMEDORA_UPGRADE_REEXEC="$tmp_self" bash "$tmp_self" ${args[@]+"${args[@]}"}
  fi
fi

# --- constants ----------------------------------------------------------------

OMEDORA_COPR_OWNER="${OMEDORA_COPR_OWNER:-agaspar}"
old_copr="$OMEDORA_COPR_OWNER/omedora-3"
new_copr="$OMEDORA_COPR_OWNER/omedora-4"
old_repo_id="copr:copr.fedorainfracloud.org:${OMEDORA_COPR_OWNER}:omedora-3"
payload="${OMEDORA_UPGRADE_PAYLOAD:-/usr/share/omarchy}"
dnf_query="${OMEDORA_DNF_CMD:-dnf}"
ts=$(date +%Y%m%d%H%M%S)
backup_tag="pre-omedora-4-$ts"
legacy_backup="$legacy_root.$backup_tag.bak"
target_uid=$(id -u)
target_runtime_dir="/run/user/$target_uid"
package_path="$payload/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin"

# --- retired-package computation (read-only; feeds the plan gate) --------------
# Two sources:
#   1. COMPUTED: every installed package whose from_repo is the omedora-3 COPR
#      and that the omedora-4 line no longer serves (the v4 spec set below is
#      the package/subpackage names omedora/packaging/copr builds on the 4.x
#      line). This catches walker/elephant/swayosd/bluetui/gazelle-tui/
#      hypridle/hyprlock/hyprshot/hyprland-omedora while KEEPING the vendored
#      Hyprland stack (same names continue on omedora-4).
#   2. STATIC extras: Fedora-proper packages the 3.8.2 line installed (via its
#      fedora.toml / omarchy-base.packages) that Omarchy 4 retires — only the
#      ones actually installed are removed, failures tolerated like upstream.

v4_kept_packages=(
  omedora omedora-settings
  quickshell
  omedora-nerd-fonts python3-terminaltexteffects
  lazygit lazydocker mise starship usage satty
  hyprland-preview-share-picker
  glaze glaze-devel
  hyprland-protocols hyprland-protocols-devel
  hyprutils hyprutils-devel
  hyprwayland-scanner hyprwayland-scanner-devel
  hyprlang hyprlang-devel
  hyprgraphics hyprgraphics-devel
  hyprwire hyprwire-devel
  hyprcursor hyprcursor-devel
  aquamarine aquamarine-devel
  hyprtoolkit hyprtoolkit-devel
  hyprland hyprland-no-session hyprland-uwsm hyprland-devel
  hyprland-guiutils hyprpicker hyprsunset
  xdg-desktop-portal-hyprland
  uwsm
)

# The known 3.8.2-era COPR set, used only when `dnf repoquery --installed`
# is unavailable/fails (e.g. very old dnf): probed one-by-one with rpm -q.
retired_copr_fallback=(
  walker elephant swayosd bluetui gazelle-tui
  hypridle hyprlock hyprshot hyprland-omedora
)

# Fedora-proper packages the 3.8.2 line installed that v4 retires (waybar/mako/
# swaybg replaced by the Quickshell shell; playerctl was waybar's media glue;
# polkit-kde was 3.8.2's polkit-gnome mapping — v4's shell handles polkit;
# wiremix replaced by the shell's audio UI). iwd is handled separately below.
retired_extra_candidates=(waybar mako swaybg playerctl polkit-kde wiremix)

is_kept_on_v4() {
  local p
  for p in "${v4_kept_packages[@]}"; do [[ $1 == "$p" ]] && return 0; done
  return 1
}

retired_packages=()
compute_retired_packages() {
  retired_packages=()
  local got_query=0 name repo pkg

  while read -r name repo _; do
    [[ -n ${name:-} && -n ${repo:-} ]] || continue
    got_query=1
    [[ $repo == "$old_repo_id" ]] || continue
    is_kept_on_v4 "$name" && continue
    retired_packages+=("$name")
  done < <("$dnf_query" repoquery --installed \
             --queryformat '%{name} %{from_repo}\n' 2>/dev/null || true)

  if (( ! got_query )); then
    warn "dnf repoquery unavailable; probing the known 3.8.2-era COPR package set instead."
    for pkg in "${retired_copr_fallback[@]}"; do
      rpm -q "$pkg" >/dev/null 2>&1 && retired_packages+=("$pkg")
    done
  fi

  for pkg in "${retired_extra_candidates[@]}"; do
    rpm -q "$pkg" >/dev/null 2>&1 && retired_packages+=("$pkg")
  done

  # iwd: v4 retires it (NetworkManager is the stack), but if iwd is ACTIVELY
  # running it may be managing this machine's Wi-Fi — removing it would stop
  # the service (Fedora's %systemd_preun) and drop the connection mid-upgrade.
  if rpm -q iwd >/dev/null 2>&1; then
    if systemctl is-active --quiet iwd.service 2>/dev/null; then
      warn "iwd is installed AND running; leaving it in place (v4 uses NetworkManager — remove iwd manually once you're sure nothing uses it)."
    else
      retired_packages+=(iwd)
    fi
  fi

  if ((${#retired_packages[@]})); then
    mapfile -t retired_packages < <(printf '%s\n' "${retired_packages[@]}" | sort -u)
  fi

  # Cascade guard: unlike pacman (which refuses), `dnf remove -y` takes
  # DEPENDENT packages down with it. Never let a retired removal cascade into
  # something the user installed (e.g. polkit-kde on a machine that also runs
  # KDE Plasma): if anything OUTSIDE the retired set requires a candidate,
  # keep the candidate installed and say so.
  retired_kept_for_dependents=()
  local candidate dep outside final=()
  for candidate in ${retired_packages[@]+"${retired_packages[@]}"}; do
    outside=""
    while IFS= read -r dep; do
      [[ -n $dep ]] || continue
      [[ $dep == "no package requires"* ]] && continue
      [[ $dep == "$candidate" ]] && continue
      if ! printf '%s\n' "${retired_packages[@]}" | grep -qxF "$dep"; then
        outside+="$dep "
      fi
    done < <(rpm -q --whatrequires --qf '%{NAME}\n' "$candidate" 2>/dev/null || true)
    if [[ -n $outside ]]; then
      retired_kept_for_dependents+=("$candidate (required by: ${outside% })")
    else
      final+=("$candidate")
    fi
  done
  retired_packages=(${final[@]+"${final[@]}"})
}
retired_kept_for_dependents=()
compute_retired_packages

# --- user-config classification (read-only; feeds the plan gate) ---------------
# Uses the same hash table the transition applies later: a user file matching a
# KNOWN SHIPPED DEFAULT hash is safe to replace; unknown content is customized
# and stays active (refresh) or stays active as an override (retire).

file_sha256() { sha256sum "$1" | awk '{print $1}'; }

