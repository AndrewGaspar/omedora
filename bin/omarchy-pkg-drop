#!/bin/bash

# omarchy:summary=Remove all the named packages from the system if they're installed (otherwise ignore).
# omarchy:args=<packages...>
# omarchy:requires-sudo=true

# Fedora dispatch — see omedora/architecture.md §3. Arch path below is unchanged.
case "${OMARCHY_DISTRO:-$(omarchy-distro 2>/dev/null || echo arch)}" in
  fedora) exec "$(dirname -- "${BASH_SOURCE[0]}")/fedora/pkg.py" drop "$@" ;;
esac

installed=()
declare -A installed_exact=()
declare -A selected=()

while IFS= read -r package_name; do
  installed_exact[$package_name]=1
done < <(pacman -Qq)

for pkg in "$@"; do
  if [[ -n ${installed_exact[$pkg]} && -z ${selected[$pkg]} ]]; then
    installed+=("$pkg")
    selected[$pkg]=1
  fi
done

if (( ${#installed[@]} > 0 )); then
  sudo pacman -Rns --noconfirm "${installed[@]}"
fi
