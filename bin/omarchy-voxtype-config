#!/bin/bash

# omarchy:summary=Open Voxtype configuration

set -e

# Fedora: voxtype installs on demand from the omedora COPR — the slim base RPM
# plus an auto-detected GPU flavor (see bin/fedora/voxtype-install-pkg). When it
# isn't installed yet, clicking the bar
# mic offers to install it — in a floating terminal, the same flow the first-run
# post-update hook and the Install > AI > Dictation menu use — instead of
# erroring on a missing `voxtype configure`. Once installed, the Arch path below
# runs unchanged. Arch is byte-identical.
if [[ "${OMARCHY_DISTRO:-$(omarchy-distro 2>/dev/null || echo arch)}" == "fedora" ]] &&
  ! command -v voxtype >/dev/null 2>&1; then
  omarchy-launch-floating-terminal-with-presentation omarchy-voxtype-install
  exit 0
fi

omarchy-launch-floating-terminal-with-presentation "voxtype configure"
omarchy-restart-shell
