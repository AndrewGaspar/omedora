#!/bin/bash

# omarchy:summary=Get remote tag

# Brand-aware wording: on omedora (Fedora, or OMARCHY_BRAND=omedora) the release
# tags are omedora's own (vX.Y.Z). The tag-compare logic is identical for both —
# omedora cuts annotated tags with omedora-release, so this Just Works once an
# install tracks a tag.
brand="Omarchy"
if [[ ${OMARCHY_BRAND:-} == "omedora" ]] || \
   [[ "$(omarchy-distro 2>/dev/null || echo arch)" == "fedora" ]]; then
  brand="Omedora"
fi

latest_tag=$(git -C "$OMARCHY_PATH" ls-remote --tags origin | grep -v "{}" | awk '{print $2}' | sed 's#refs/tags/##' | sort -V | tail -n 1)
if [[ -z $latest_tag ]]; then
  echo "Error: Could not retrieve latest tag."
  exit 1
fi

# Get local tag
current_tag=$(git -C "$OMARCHY_PATH" describe --tags $(git -C "$OMARCHY_PATH" rev-list --tags --max-count=1))
if [[ -z $current_tag ]]; then
  echo "Error: Could not retrieve current tag."
  exit 1
fi

if [[ $current_tag != $latest_tag ]]; then
  echo "$brand update available ($latest_tag)"
  exit 0
else
  echo "$brand is up to date ($current_tag)"
  exit 1
fi
