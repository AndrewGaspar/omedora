#!/bin/bash

# omarchy:summary=Launch the wifi controls (Impala on Arch/iwd, Gazelle on Fedora/NetworkManager).

rfkill unblock wifi

# impala drives iwd; Fedora Workstation rides NetworkManager (no iwd), so there
# we launch gazelle — a NetworkManager wifi TUI filling the same slot.
if [[ $(omarchy-distro 2>/dev/null || echo arch) == "fedora" ]]; then
  omarchy-launch-or-focus-tui gazelle
else
  omarchy-launch-or-focus-tui impala
fi
