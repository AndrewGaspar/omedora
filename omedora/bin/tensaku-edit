#!/bin/bash
#
# omedora Fedora shim for Omarchy's screenshot / clipboard annotation editor.
#
# The quattro line switched Omarchy's editor from satty to `tensaku-edit` (the
# `tensaku` package). omedora now packages tensaku natively (COPR-hosted,
# omedora/packaging/copr/tensaku.spec) which ships the real /usr/bin/tensaku-edit;
# this thin satty wrapper is the FALLBACK used only when that package is absent.
# These are the exact flags Omarchy itself used for satty at the pre-quattro pin,
# so omarchy-capture-screenshot, omarchy-clipboard-open and config/imv/config
# stay byte-identical to upstream.
#
# Invoked as: tensaku-edit <image-path>. Installed into ~/.local/bin by
# install/user/tensaku-edit-shim-fedora.sh (which skips shadowing the genuine
# tensaku-edit that the tensaku package provides).

exec satty --filename "$1" \
  --output-filename "$1" \
  --actions-on-enter save-to-clipboard \
  --save-after-copy \
  --copy-command 'wl-copy --type image/png'
