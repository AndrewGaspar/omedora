#!/bin/bash

# Omedora XR display-manager entry point: seed the per-user Lua config when
# absent, then hand off to the session launcher.

set -euo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland-xr.lua"

if [[ ! -r $config ]]; then
  /usr/bin/omarchy-setup-hypxrland
fi

# 6DoF tracking is CPU-bound, and on battery the default power profile turns
# turbo off, so hold the "performance" profile while the session runs. The
# helper is detached and watches this PID. The execs below keep that PID for
# the whole session: hypxrland-session execs uwsm, which execs its waiting
# shell. The daemon drops the hold when the helper exits. Every failure only
# logs, so the session never waits on the hold. Picking a profile by hand ends
# the hold for this session; OMEDORA_XR_PERFORMANCE_HOLD=0 turns it off.
if [[ ${OMEDORA_XR_PERFORMANCE_HOLD:-1} != "0" ]]; then
  setsid -f /usr/libexec/hypxrland-omedora/performance-hold "$$" </dev/null || true
fi

exec /usr/bin/hypxrland-session "$@"
