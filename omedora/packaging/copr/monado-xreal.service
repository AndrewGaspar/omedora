[Unit]
Description=Monado XREAL Air OpenXR runtime for HypXRland
Documentation=https://github.com/AndrewGaspar/Hyprland
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=XRT_COMPOSITOR_FORCE_WAYLAND=1
Environment=XRT_NO_STDIN=1
# The build moves the IPC socket to $XDG_RUNTIME_DIR/monado-xreal/comp_ipc and
# Monado never creates that directory. systemd creates it on start and removes
# it on stop, which also clears the socket the SIGKILL stop leaves behind.
RuntimeDirectory=monado-xreal
RuntimeDirectoryMode=0700
# 6DoF (visual-inertial SLAM) stays off until XREAL_AIR_SLAM=1 is set in a
# drop-in. When it is on, Monado loads the Basalt tracker from basalt-xreal's
# private libdir and its XREAL pipeline settings (Monado's own default looks in
# <libdir>/../share/basalt, which the private layout does not have).
Environment=VIT_SYSTEM_LIBRARY_PATH=/usr/lib64/basalt-xreal/libbasalt.so.2
Environment=XREAL_AIR_SLAM_CONFIG=/usr/share/basalt-xreal/xreal_air.toml
ExecStart=/usr/libexec/monado-xreal/monado-service
Restart=no
KillSignal=SIGKILL
KillMode=mixed
TimeoutStopSec=10
SuccessExitStatus=SIGKILL

[Install]
WantedBy=graphical-session.target
